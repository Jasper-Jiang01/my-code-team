# ============================================================
# CodePilot 后端环境变量模板
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# ============================================================

# ---- LLM ----
# LongCat（美团内部，OpenAI 兼容接口）
# 文档：https://longcat.chat/platform/docs/zh/
LONGCAT_API_KEY=your_longcat_api_key
LONGCAT_BASE_URL=https://api.longcat.chat/openai
DEFAULT_MODEL=LongCat-2.0

# OpenAI（可选，切换 DEFAULT_MODEL 为 gpt-4o 时需要）
OPENAI_API_KEY=your_openai_api_key

# Anthropic（可选，切换 DEFAULT_MODEL 为 claude-xxx 时需要）
ANTHROPIC_API_KEY=your_anthropic_api_key

# ---- 数据库（PostgreSQL）----
DATABASE_URL=postgresql://user:password@localhost:5432/codepilot

# ---- 向量存储（Chroma）----
VECTOR_STORE_URL=http://localhost:6333

# ---- LangSmith 可观测性（可选）----
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=codepilot

# ---- 内部工具端点（可选；未配置时使用本地夹具，保证证据链可跑通）----
KM_SEARCH_ENDPOINT=
# 学城 Citadel：配置 MIS 后 search_km 走 oa-skills citadel searchContent
# 首次调用需在大象 App 确认授权；oa-skills 必须在运行 langgraph 的 PATH 里
KM_MIS=
# 对前 N 篇命中拉 getSimpleMarkdown 作为正文（更准，更慢；0 表示只用搜索摘要）
KM_FETCH_BODY_TOP_K=2
KM_SNIPPET_MAX_CHARS=1500
KM_CITADEL_TIMEOUT=60
SQL_QUERY_ENDPOINT=
MCP_ENDPOINT=
# 点评 PDE Agent HTTP 适配层（可选）。未配置时 GENERATE 仍会本地产出可截图原型 HTML
# 操作指南：https://km.sankuai.com/collabpage/2776444575
PDE_ENDPOINT=
PDE_TIMEOUT=60
